{
  "name": "marketplace-mobilier",
  "private": true,
  "scripts": {
    "build:shared": "pnpm -F @marketplace/shared build",
    "dev:backend": "pnpm -F backend dev",
    "dev:frontend": "pnpm -F frontend dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:tools": "node --test tools/release/verify-slot.test.mjs tools/release/require-green-ci.test.mjs tools/release/scan-secrets.test.mjs",
    "infra:up": "docker compose -f dev-infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f dev-infra/docker-compose.yml down"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "multer": "^2.4.0",
      "ws": ">=8.21.0",
      "socket.io-parser": ">=4.2.7",
      "body-parser": ">=1.20.6",
      "qs": "^6.16.0",
      "postcss": ">=8.5.23",
      "sharp": "^0.35.5",
      "file-type": "^21.3.2",
      "fflate": "^0.8.2",
      "fast-uri": "^3.1.8",
      "browserslist": "^4.28.7",
      "webpack": "^5.104.1",
      "baseline-browser-mapping": "^2.11.0",
      "engine.io": ">=6.6.10",
      "brace-expansion@<2": ">=1.1.20 <2",
      "brace-expansion@>=2 <3": ">=2.1.6 <3",
      "js-yaml@<4": ">=3.15.2 <4",
      "js-yaml@>=4 <5": ">=4.3.2 <5",
      "glob@>=10 <11": ">=10.5.0 <11",
      "picomatch@>=4 <5": ">=4.0.4 <5",
      "tmp": ">=0.2.6",
      "proxy-addr": ">=2.0.8",
      "handlebars": ">=4.7.10",
      "source-map-js": ">=1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
