NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# BACKEND_INTERNAL_URL: doar la deploy (rewrites same-origin catre backend); gol in dev
# BACKEND_INTERNAL_URL=http://127.0.0.1:3001
# Originea publica a site-ului (fara slash final): metadataBase pentru SEO
# (canonical, hreflang, Open Graph), robots.txt si sitemap.xml. Pe prod = domeniul
# real (ex. https://cozyhome.ro); lipsa → http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Adresa de suport publica (casuta monitorizata). TREBUIE sa fie aceeasi cu SUPPORT_EMAIL
# din backend. Se coace la build (schimbarea = rebuild). Gol → /.well-known/security.txt
# raspunde 404 si linia de contact la "cont blocat" nu apare.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional: cheie Google Maps (Places Autocomplete) pentru adresa din configurator.
# UI-only — geocodarea ramane pe server prin Nominatim (invarianta 3.8).
# Necesita proiect GCP cu billing + restrictie de cheie pe domeniu; fara cheie,
# formularul degradeaza la inputuri text simple.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Observabilitate (E-admin-platform-8) — goale = dezactivate; se coc la build (vezi docs/08)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ANALYTICS_PROVIDER=   (umami | plausible)
# NEXT_PUBLIC_ANALYTICS_HOST=       (origine https)
# NEXT_PUBLIC_ANALYTICS_SITE_ID=
# NEXT_PUBLIC_RELEASE_SHA=          (din RELEASE_SHA la build-ul Docker)
