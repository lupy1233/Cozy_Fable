# Copiaza in .env pentru dev local. Validat cu Zod la boot — lipsa = fail-fast.
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace

REDIS_HOST=localhost
REDIS_PORT=6379
# Optional (hosting managed cu auth — Railway/Upstash); gol in dev local
REDIS_PASSWORD=

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads
S3_REGION=us-east-1

SMTP_HOST=localhost
SMTP_PORT=1025
# Optional — provider SMTP real in prod (Brevo/Resend/etc): user+pass si SMTP_SECURE=true pe 465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=no-reply@marketplace-mobilier.local

# Secrete — obligatorii (boot fail-fast daca lipsesc)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
IP_HASH_SALT=dev-ip-salt-change-me

# 2FA flag (invarianta 3.13 — off in MVP)
TWO_FACTOR_FEATURE_ENABLED=false

# Criptare la stocare a mesajelor de chat (AES-256-GCM) — OBLIGATORIE in productie.
# Genereaza cu: openssl rand -hex 32. Pastreaza cheia intr-un seif: pierderea = chat ilizibil.
MESSAGE_ENCRYPTION_KEY=

# Geocoding Nominatim (invarianta 3.8) — pe prod pune un contact real in user-agent
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=cozy-home/1.0 (contact: contact@example.com)

# Stripe Checkout (plati reale credite/abonamente, decizie PO 2026-08-19).
# Chei de TEST in dev (sk_test_... / whsec_...). Lipsa ambelor = plata online dezactivata.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
