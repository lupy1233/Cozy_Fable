# Copiaza in .env pentru dev local. Validat cu Zod la boot — lipsa = fail-fast.
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace

REDIS_HOST=localhost
REDIS_PORT=6379
# Optional (hosting managed cu auth — Railway/Upstash); gol in dev local
REDIS_PASSWORD=

# Local: minioadmin e OK. Productie: cheie de serviciu limitata la bucket
# (deploy/storage/setup-minio-uploads.sh), niciodata root; boot-ul avertizeaza la credentiale implicite.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads
S3_REGION=us-east-1

# Email. Dev = Mailpit local (fara TLS, fara auth). In PRODUCTIE boot-ul se opreste daca:
# hostul e de captura/intern (localhost, mailpit, green-mail, *.internal, *.local), portul e
# 1025/8025, lipsesc SMTP_USER/SMTP_PASS, MAIL_FROM nu are nume afisat sau e pe un domeniu
# de test, ori lipseste SUPPORT_EMAIL. Supapa SMTP_ALLOW_DEV_HOST=true le scuteste pe toate
# (doar pentru stack-ul local prod-like / previzualizarea izolata cu captura).
SMTP_HOST=localhost
SMTP_PORT=1025
# Obligatorii in prod (provider SMTP real in UE: Brevo, Postmark EU, Amazon SES eu-central-1)
SMTP_USER=
SMTP_PASS=
# true pe portul 465 (TLS implicit); pe 587 lasa false — STARTTLS e impus automat in prod
SMTP_SECURE=false
# Prod: formatul obligatoriu "Cozy Home" <notificari@domeniu-final> (domeniu autentificat SPF/DKIM)
MAIL_FROM=no-reply@marketplace-mobilier.local
# Obligatoriu in prod: casuta de suport MONITORIZATA (nu no-reply). E Reply-To pe emailurile
# de cont/facturare si apare in subsolul emailurilor. Aceeasi adresa ca NEXT_PUBLIC_SUPPORT_EMAIL.
SUPPORT_EMAIL=

# Secrete — obligatorii (boot fail-fast daca lipsesc)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
IP_HASH_SALT=dev-ip-salt-change-me

# 2FA flag (invarianta 3.13 — off in MVP)
TWO_FACTOR_FEATURE_ENABLED=false

# Criptare la stocare a mesajelor de chat (AES-256-GCM) — OBLIGATORIE in productie.
# Genereaza cu: openssl rand -hex 32. Pastreaza cheia intr-un seif: pierderea = chat ilizibil.
MESSAGE_ENCRYPTION_KEY=

# Geocoding Nominatim (invarianta 3.8) — pe prod pune un contact real in user-agent
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=cozy-home/1.0 (contact: contact@example.com)

# Stripe Checkout (plati reale credite/abonamente, decizie PO 2026-08-19).
# Chei de TEST in dev (sk_test_... / whsec_...). Lipsa ambelor = plata online dezactivata.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# STRIPE_ALLOW_TEST_MODE=false  # doar staging izolat; productia refuza sk_test_ fara acest flag

# Observabilitate (E-admin-platform-8) — vezi docs/08 "Observabilitate"
# LOG_LEVEL=info
# SENTRY_DSN=  (gol = tracker dezactivat; DSN Sentry EU sau GlitchTip dupa decizia PO)
# SENTRY_ENVIRONMENT=production

# IP-ul clientului + rate limiting (E-admin-platform-5) — vezi docs/08 "IP client si rate limit"
# Headerul suprascris de edge cu IP-ul real (ex. x-real-ip). Seteaza-l DOAR dupa ce testul de
# spoofing din verify-slot.mjs trece, pe AMBELE sloturi. Nesetat = limitele cheie pe req.ip
# (adresa proxy-ului in productie). x-forwarded-for e refuzat la boot.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# Stocarea throttlerului: redis (implicit, partajat intre procese) | memory (per proces)
# THROTTLER_STORE=redis

# Health (E-admin-platform-56) — vezi docs/08 "Health public si token"
# Corpul public /api/v1/health{,/live,/ready} e doar {status}. Detaliile (slot/mode/sha/checks/client)
# se dau DOAR cu headerul X-Health-Token egal cu acest token (min. 32 caractere, ex. openssl rand -hex 32).
# Nesetat = detaliile nu se dau niciodata. Folosit de tools/release/verify-slot.mjs din env.
# HEALTH_DETAILS_TOKEN=
# Interfata pe care asculta Nest: nesetat = toate (dev/compose); 127.0.0.1 in containerul combinat
# (start-combined.sh o seteaza singur). Doar adrese IP.
# LISTEN_HOST=
